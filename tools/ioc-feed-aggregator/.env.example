# Copie para .env e ajuste. O docker compose lê este arquivo automaticamente.

# URL pública (canonical, Open Graph, sitemap). Mudou? Rode `docker compose build frontend`.
SITE_URL=https://cti.segark.com

# Porta publicada no host. O proxy reverso/TLS (Caddy, nginx, Traefik, Cloudflare Tunnel) aponta para ela.
HTTP_PORT=5000

# Token exigido para ler e alterar a lista de exclusão (console e /api/v1/exclusions).
# Gere com: openssl rand -hex 32. Vazio = API de exclusões aberta (não recomendado em produção).
ADMIN_TOKEN=

# Senha do PostgreSQL. Em instalações existentes o volume já foi criado com "postgres":
# troque também dentro do banco (ALTER USER) antes de mudar aqui.
POSTGRES_PASSWORD=postgres

# Coleta das fontes (segundos). 0 desativa a coleta automática.
REFRESH_INTERVAL_SECONDS=3600

# Workers do gunicorn.
WEB_CONCURRENCY=2

# Limite de requisições por IP na API (o burst absorve picos curtos).
API_RATE_LIMIT=10r/s
API_RATE_BURST=40
