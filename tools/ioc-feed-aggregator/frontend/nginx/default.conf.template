# Gerado no start do container a partir deste template (envsubst da imagem oficial do nginx).
# Variáveis: API_UPSTREAM, API_RATE_LIMIT, API_RATE_BURST e NGINX_LOCAL_RESOLVERS (lido do /etc/resolv.conf).

limit_req_zone $binary_remote_addr zone=api:10m rate=${API_RATE_LIMIT};
limit_req_status 429;
limit_req_log_level warn;

# Atrás de outro proxy com TLS (ex.: o que atende cti.segark.com), preserva o esquema original.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 8080 default_server;
    server_name _;

    root /usr/share/nginx/html;
    charset utf-8;
    server_tokens off;
    absolute_redirect off;
    client_max_body_size 1m;

    # IP real do cliente quando há um proxy reverso na frente (redes privadas e Docker).
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    gzip on;
    gzip_static on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml application/javascript application/json application/xml
               application/manifest+json image/svg+xml;

    # Resolve o upstream a cada 10 s: o site continua no ar mesmo se a API reiniciar ou trocar de IP.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    resolver_timeout 3s;
    set $api_upstream http://${API_UPSTREAM};

    include /etc/nginx/snippets/security-headers.conf;

    # API -------------------------------------------------------------------------
    location ^~ /api/ {
        limit_req zone=api burst=${API_RATE_BURST} nodelay;
        include /etc/nginx/snippets/proxy.conf;
    }

    # Rota legada da lista de exclusão.
    location = /exclusions {
        limit_req zone=api burst=${API_RATE_BURST} nodelay;
        include /etc/nginx/snippets/proxy.conf;
    }

    location = /healthz {
        access_log off;
        include /etc/nginx/snippets/proxy.conf;
    }

    # Feeds: servidos direto do volume compartilhado com a API (continuam no ar sem a API).
    location ~ ^/feeds/(urls|domains|ipv4)\.txt$ {
        root /srv;
        default_type text/plain;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=300" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Robots-Tag "noindex" always;
    }

    location = /feeds/SHA256SUMS {
        root /srv;
        default_type text/plain;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=300" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Robots-Tag "noindex" always;
    }

    # Site estático ---------------------------------------------------------------
    location ^~ /_astro/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location ~* \.(?:png|ico|svg|webmanifest)$ {
        types {
            image/png png;
            image/x-icon ico;
            image/svg+xml svg;
            application/manifest+json webmanifest;
        }
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=86400" always;
        try_files $uri =404;
    }

    location = /theme.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=3600" always;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
}
